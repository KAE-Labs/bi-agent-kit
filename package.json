{
  "name": "bi-agent-kit",
  "version": "0.1.0",
  "description": "Installs BI-related MCP server entries into AI coding tool configs, without clobbering anything else already there.",
  "type": "module",
  "bin": {
    "bi-agent-kit": "./bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "business-intelligence",
    "power-bi",
    "dataverse",
    "fabric",
    "dbt",
    "snowflake",
    "postgres",
    "azure",
    "ai-agents",
    "claude-code",
    "cursor",
    "copilot",
    "installer",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kae-labs/bi-agent-kit.git"
  },
  "homepage": "https://github.com/kae-labs/bi-agent-kit#readme",
  "bugs": {
    "url": "https://github.com/kae-labs/bi-agent-kit/issues"
  },
  "author": "KAE Labs LLC (https://kaelabs.dev)",
  "license": "MIT",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "0.9.1",
    "smol-toml": "1.3.1",
    "jsonc-parser": "3.3.1"
  }
}
